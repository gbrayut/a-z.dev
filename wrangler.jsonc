{
  // Cloudflare Workers with Static Assets (no main script)
  // Worker endpoint: https://hugo.a-z-d.workers.dev
  "name": "hugo",
  "compatibility_date": "2026-11-23",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
